import numpy as np
import matplotlib.pyplot as plt
import matplotlib.cm as cm


file_list = ['1peak_1100mK.npz', '1peak_1050mK_1000pt.npz', '1peak_1000mK_2000pt.npz', '1peak_950mK_2000pt.npz', '1peak_900mK_3000pt.npz', '1peak_850mK.npz', '1peak_820mK.npz', '1peak_750mK.npz', '1peak_700mK.npz', '1peak_600mK.npz', '1peak_500mK.npz', '1peak_400mK_10kpt.npz', '1peak_300mK_10kpt.npz', '1peak_200mK_10kpt.npz', '1peak_100mK_10kpt.npz']
#file_list = ['8GHzpeak_1100mK.npz', '8GHzpeak_1050mK.npz', '8GHzpeak_1000mK_2000pt.npz', '8GHzpeak_950mK_2000pt.npz', '8GHzpeak_900mK_3000pt.npz', '8GHzpeak_850mK.npz', '8GHzpeak_800mK.npz', '8GHzpeak_750mK.npz', '8GHzpeak_700mK.npz', '8GHzpeak_600mK.npz', '8GHzpeak_500mK.npz', '8GHzpeak_400mK_10kpt.npz', '8GHzpeak_300mK_10kpt.npz', '8GHzpeak_200mK_10kpt.npz', '8GHzpeak_100mK_10kpt.npz', '8GHzpeak_13mK.npz']

temperature = [1100,1050,1000,950,900,875,820,750,700,600,500,400,300,200,100,13]  # in mK

# Creo una figura con 2 grafici affiancati (1 riga, 2 colonne)
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))

cmap = cm.get_cmap('plasma') 
T_min, T_max = min(temperature), max(temperature)

# Liste per salvare i dati del secondo grafico
T_estratte = []
f_res_estratte = []

for nome_file, T in zip(file_list, temperature):
    try:
        data = np.load(nome_file, allow_pickle=True)
        
        struttura = data['0']
        freqs = struttura['freq']
        mag = struttura['signal']
        phase = struttura['phase']
        
        # 1. Trova la frequenza di risonanza (punto di minimo del segnale)
        idx_min = np.argmin(mag)
        f_res_GHz = freqs[idx_min] / 1e9
        
        # Salvo i valori per il grafico di destra
        T_estratte.append(T)
        f_res_estratte.append(f_res_GHz)
        
        # Calcolo del colore
        color_val = (T - T_min) / (T_max - T_min) if T_max > T_min else 0.5
        colore = cmap(color_val)
        
        # Plot dei dati sul grafico comune (pannello 1)
        ax1.plot(freqs / 1e9, mag, '.', markersize=3, color=colore, label=f'{T} mK')
        
    except Exception as e:
        print(f"Errore nel processare il file {nome_file}: {e}")

# --- Formattazione Grafico 1: Spettri ---
ax1.set_title('Evoluzione delle Risonanze vs T')
ax1.set_xlabel('Frequenza (GHz)')
ax1.set_ylabel('|S21|')
ax1.grid(True, linestyle='--', alpha=0.7)
ax1.legend(title='Temperatura', loc='best', fontsize=8)

# --- Formattazione Grafico 2: F_res vs Temperatura ---
# Disegno la curva (punti uniti da linea)
ax2.plot(T_estratte, f_res_estratte, marker='o', linestyle='-', color='black', 
         markerfacecolor='red', markersize=6)

ax2.set_title('Frequenza di Risonanza in funzione della Temperatura')
ax2.set_xlabel('Temperatura (mK)')
ax2.set_ylabel('Frequenza di Risonanza $f_r$ (GHz)')
ax2.grid(True, linestyle='--', alpha=0.7)

